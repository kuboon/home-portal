# Local development (server/dev.ts). Production values live in
# cloudflare/cloudflare.config.ts (text vars) — see cloudflare/README.md.

# IdP origin for passkey sign-in (delegated). Default: https://id.kbn.one
IDP_ORIGIN=https://id.kbn.one

# This app's own origin (RP). Used as the push client-assertion iss/sub and the
# JWKS issuer; must be in the IdP's AUTHORIZE_WHITELIST. Default https://home.kbn.one
RP_ORIGIN=https://home.kbn.one

# storage.kbn.one origin for stamp / image uploads. Default https://storage.kbn.one
STORAGE_ORIGIN=https://storage.kbn.one

# SQLite file standing in for D1 locally. Default: .local/dev.sqlite
# DEV_DB_PATH=.local/dev.sqlite
