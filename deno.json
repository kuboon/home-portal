{
  "workspace": [
    "./packages/session-storage-kv",
    "./packages/remix-dpop-session-middleware",
    "./packages/db",
    "./bundler",
    "./server",
    "./client",
    "./scripts"
  ],
  "tasks": {
    "dev": "deno task --cwd server dev",
    "serve": "deno task --cwd server serve",
    "bundle": "deno task --cwd bundler build",
    "build:cloudflare": "deno run -A bundler/cloudflare.ts",
    "deploy": "deno task build:cloudflare && cd cloudflare && npx cf deploy --prebuilt",
    "test": "deno test -P",
    "check": "deno check && deno lint && deno fmt --check"
  },
  "permissions": {
    "default": {}
  },
  "test": {
    "permissions": "default"
  },
  "nodeModulesDir": "auto",
  "unstable": [
    "bundle"
  ],
  "imports": {
    "@kuboon/kv": "jsr:@kuboon/kv@^0.4.0"
  },
  "exclude": [
    "cloudflare/dist/",
    "cloudflare/node_modules/",
    "cloudflare/.cloudflare/",
    "cloudflare/cloudflare.config.ts",
    ".local/",
    "migration-data/"
  ]
}
